# Copy to .env locally. Never commit real credentials.
# Default native CLI and live Web: set a private product JSON path (see docs/native-product-runtime.md).
# AXONFIRE_NATIVE_PRODUCT_CONFIG=/absolute/path/to/private-product.json
# The OPENAI_* settings below configure only the explicit standalone workbench hosts.
OPENAI_API_KEY=
# Explicit OpenAI-compatible Chat Completions endpoint; no product login is read.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional model selection override; for native mode it must match your product model ID.
# CODEBUDDY_MODEL=gpt-4.1
AXONFIRE_PORT=3080
# Tool workspace. Defaults to the directory from which the launcher was invoked.
# AXONFIRE_WORK_DIR=/absolute/path/to/your/project
# AXONFIRE_STATE_DIR=/absolute/path/to/private/state

# Optional original sandbox approval timeout (milliseconds).
# Native -p/--print defaults to 100 ms without an approval UI; interactive/ACP/streaming-input SDK clients keep original defaults.
# CBC_SANDBOX_APPROVAL_TIMEOUT_MS=100
