# Copy to .env locally. Never commit real credentials.
OPENAI_API_KEY=
# Explicit OpenAI-compatible Chat Completions endpoint; no product login is read.
OPENAI_BASE_URL=https://api.openai.com/v1
CODEBUDDY_MODEL=gpt-4.1
AXONFIRE_PORT=3080
# Tool workspace. Defaults to the directory from which the launcher was invoked.
# AXONFIRE_WORK_DIR=/absolute/path/to/your/project
# AXONFIRE_STATE_DIR=/absolute/path/to/private/state
